{
  "name": "@vibestartup/thing-lint",
  "version": "0.1.0",
  "description": "canonical-dialect linter + concrete-syntax printer driver for vibestartup Things",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/vibestartup/thing-lint.git" },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": { "build": "tsup", "dev": "tsup --watch", "typecheck": "tsc --noEmit", "test": "vitest run", "clean": "rm -rf dist" },
  "dependencies": {
    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "@babel/types": "^7.25.0",
    "@vibestartup/thing": "workspace:*"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.0",
    "tsup": "^8.3.0", "typescript": "^5.6.0", "vitest": "^2.1.0"
  }
}
